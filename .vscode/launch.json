{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug RayTracer",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/RayTracer_debug",
      "args": ["128", "1", "0", "debug.ppm"],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "build debug"
    }
  ]
}
